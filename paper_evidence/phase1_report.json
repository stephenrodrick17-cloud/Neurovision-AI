  "conflicts_and_discrepancies": [
    {
      "issue": "SmallCNN Seed 42 Near-Threshold Prediction Shift",
      "details": "Original SmallCNN checkpoint (small_cnn_best.pth) on image Cancer (2164).jpg had tumor_score = 0.4997877 (predicted No-Tumor, giving confusion matrix [[155, 66], [49, 336]], acc = 81.02%). In Phase 1B multi-seed rerun (seed 42), tumor_score was 0.5001502 (predicted Tumor, giving confusion matrix [[155, 66], [48, 337]], acc = 81.19%).",
      "status": "Documented conflict across project files. Original single-checkpoint report uses 81.02%; multi-seed summary table uses 81.19% for seed 42."
    },
    {
      "issue": "Bootstrap Confidence Interval Replicate Count",
      "details": "Stored bootstrap CI used 1,000 resamples (seed 42). Independent verification used 2,000 resamples (seed 0). Both are recorded in experiments_results/phase1c/resnet18_group_bootstrap_2000_seed0.json with minimal difference (Accuracy lower bound: 96.28% vs 96.01%).",
      "status": "Documented variance due to resample count and random seed."
    },
    {
      "issue": "Git Tracking of Model Weights and Manifests",
      "details": "All .pth checkpoint weight files (19 files) and split_manifest.csv are correctly untracked (.gitignored) due to file size constraints, though checkpoint SHA-256 digests and hashes are strictly tracked in Git.",
